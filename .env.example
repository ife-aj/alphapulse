# Server
PORT=3000

# Required at startup: missing API keys or malformed values below fail the
# bootstrap (ConfigModule validate), so a misconfigured app never runs silently.
# Finnhub market-data provider — get a free key at https://finnhub.io/dashboard
FINNHUB_API_KEY=your_finnhub_api_key_here
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# Twelve Data — historical daily candles (Finnhub's candle endpoint is premium-only).
# Get a free key at https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here
TWELVE_DATA_BASE_URL=https://api.twelvedata.com

# Outbound timeout (ms) for market-data provider requests (Finnhub + Twelve Data).
# A provider that has not answered in this window is reported as 504 Gateway Timeout.
MARKET_PROVIDER_TIMEOUT_MS=5000

# Symbols returned by GET /api/market/quotes when the request omits ?symbols=
DEFAULT_SYMBOLS=AAPL,MSFT,NVDA,TSLA,AMZN,GOOGL

# How often the realtime layer revalues active portfolios (ms). Optional —
# defaults to 60000. Each cycle loads fresh holdings, prices every unique
# symbol once, and pushes a portfolio:valuation to each subscribed client, so
# this is also the ceiling on market-provider load: lower it and every
# connected portfolio is re-quoted more often. Must be a positive integer.
REALTIME_REFRESH_INTERVAL_MS=60000

# Supabase — Postgres, Auth, and Realtime backend. Both values are required at
# startup (see src/config/env.validation.ts). Find them at
# Project Settings > API in the Supabase dashboard.
# The anon/publishable key is designed to be public: requests stay sandboxed by
# Row Level Security and per-user auth tokens. Never put the secret service-role
# key here or anywhere client-side.
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# SERVER-ONLY. Supabase service-role key, used only by trusted internal reads
# that must not depend on an expiring user session (the realtime valuation
# pipeline loading a portfolio's holdings). It BYPASSES Row Level Security, so
# treat it as a full-database credential: never commit it, never log it, never
# send it to a browser, never expose it through a REST response or socket
# payload, and never put it in a client-side variable (NEXT_PUBLIC_*, VITE_*,
# REACT_APP_*). Find it under Project Settings > API in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Direct Postgres (unused for now — the Supabase client covers DB access later)
# DATABASE_URL=
